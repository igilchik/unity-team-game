# Unity YAML: merge as text
*.unity      text eol=lf merge=unityyamlmerge
*.prefab     text eol=lf merge=unityyamlmerge
*.asset      text eol=lf merge=unityyamlmerge
*.mat        text eol=lf merge=unityyamlmerge
*.anim       text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.meta       text eol=lf
*.cs         text diff=csharp

# Binary files: never touch line endings, no text diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.psd   binary
*.tga   binary
*.tif   binary
*.exr   binary
*.hdr   binary
*.fbx   binary
*.obj   binary
*.blend binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.mp4   binary
*.ttf   binary
*.otf   binary
*.zip   binary
